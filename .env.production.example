# Exemple de variables de production — liste complète : DEPLOIEMENT_PRODUCTION.md
# Ne jamais committer de vraies valeurs.
PROFITOS_ENV=production
PROFITOS_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host:5432/profitos
APP_BASE_URL=https://app.profitos.fr
PG_CONNECT_TIMEOUT=10
PG_APPLICATION_NAME=profitos
PG_POOL_MAX=10
MAX_UPLOAD_MB=15

# Documents clients : disque PERSISTANT (Render Disk monté sur /var/data).
# Jamais /tmp : le préflight de déploiement refuse un répertoire éphémère.
PROFITOS_UPLOAD_DIR=/var/data/uploads

# Sauvegardes chiffrées (scripts/backup.py, RESTORE.md)
BACKUP_DIR=/var/data/backups
BACKUP_PASSPHRASE=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Tâches planifiées (cron -> service web)
JOBS_TRIGGER_TOKEN=

# Email transactionnel : Resend (recommandé) ou SMTP. Obligatoire en production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProfitOS <noreply@profitos.fr>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Suivi des erreurs (optionnel)
SENTRY_DSN=

# Facturation Stripe : voir STRIPE_SETUP.md
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_BUSINESS_ID=

# Rate limiting partagé. Local: memory:// ; Render: injecté automatiquement.
REDIS_URL=memory://

# Open Banking — Powens
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Supervision — jeton requis pour le détail de GET /ops/health (en-tête X-Ops-Token)
OPS_HEALTH_TOKEN=

# Déclarations fiscales. Sans partenaire EDI (EDI_PARTNER_ENABLED=0), ProfitOS prépare les
# déclarations et l'entreprise les dépose sur impots.gouv.fr, puis archive l'accusé.
# Partenaire EDI agréé par la DGFiP (EDI-TVA, EDI-TDFC, EDI-Paiement) : 1 + URL https + clé.
# EDI_SIMULATION_ENABLED=1 : dépôt EDI simulé, pour les tests uniquement.
EDI_PARTNER_ENABLED=0
# EDI_PARTNER_API_URL=https://api.partenaire-edi.example
# EDI_PARTNER_API_KEY=
# Préparation des déclarations ouverte aux clients (production) : seulement après validation
# des calculs (docs/validation-fiscale.md). Organisations pilotes : identifiants séparés par des virgules.
FISCAL_DECLARATIONS_ENABLED=0
# FISCAL_DECLARATIONS_PILOT_ORGS=
# Veille de secteur : flux d'actualités repris (titre + lien), sources à licence ouverte seulement.
# MARKET_NEWS_FEEDS=[{"url": "https://exemple.gouv.fr/rss.xml", "source": "Nom", "sectors": ["all"]}]
# Adresse du fichier INSEE de correspondance des séries (facultatif, sinon recherche automatique) :
# MARKET_INSEE_IDBANK_FILE=https://www.insee.fr/fr/statistiques/fichier/2862759/202610_correspondance_idbank_dimension.zip

# Expert Network : administrateurs de l'annuaire des experts partenaires (/admin/experts)
# PLATFORM_ADMIN_EMAILS=vous@exemple.fr
