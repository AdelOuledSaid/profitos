PROFITOS_ENV=production
PROFITOS_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host:5432/profitos
APP_BASE_URL=https://your-profitos-domain.example
PG_CONNECT_TIMEOUT=10
PG_APPLICATION_NAME=profitos
MAX_UPLOAD_MB=25

# V1.2 conserve encore les fichiers importés localement. Sur un cloud à disque
# éphémère, utilisez /tmp pour les uploads transitoires. Le stockage objet arrive en V1.3.
PROFITOS_UPLOAD_DIR=/tmp/profitos-uploads

# Optional Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_BUSINESS_ID=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Transactional email (never commit a real API key)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProfitOS <noreply@profitos.fr>
APP_BASE_URL=https://app.profitos.fr

# Rate limiting partagé. Local: memory:// ; Render: injecté automatiquement.
REDIS_URL=memory://
