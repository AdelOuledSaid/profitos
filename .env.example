# Copier en .env (non commité) et adapter. Ce fichier n'est pas chargé
# automatiquement par app.py — utiliser python-dotenv ou l'injection de
# variables d'environnement de votre hébergeur (Render, Railway, Fly.io...).

# --- Sécurité ---
# OBLIGATOIRE en production : sans elle, une clé aléatoire est générée à
# chaque redémarrage et invalide toutes les sessions + tokens CSRF en cours.
PROFITOS_SECRET_KEY=change-me-to-a-long-random-value

# --- Base de données ---
# Non définie = SQLite local (tenant_data/org_<id>.db), zéro configuration.
# Définie = PostgreSQL, un schéma par organisation. Voir MIGRATION_POSTGRES.md.
# DATABASE_URL=postgresql://user:password@host:5432/profitos

# --- Email transactionnel (vérification, reset mot de passe, rapport hebdo) ---
# Non définis = mode simulation, aucun email n'est réellement envoyé.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=xxxx
# SMTP_PASSWORD=xxxx
# SMTP_FROM=reports@votredomaine.com

# --- URL publique de l'application (utilisée dans les liens email) ---
# APP_BASE_URL=https://app.profitos.io

# --- Facturation Stripe ---
# Non définis = billing désactivé, l'app reste utilisable sans limite (mode démo/dev).
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# STRIPE_PRICE_ID=price_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx


# Rate limiting partagé. Local: memory:// ; Render: injecté automatiquement.
REDIS_URL=memory://
