{
  "appId": "fr.profitos.app",
  "appName": "Veqalio",
  "webDir": "www",
  "server": {
    "url": "https://veqalio.com",
    "cleartext": false,
    "allowNavigation": [
      "*.powens.com",
      "*.weinvoice.fr",
      "*.swan.io",
      "*.gocardless.com",
      "*.dropbox.com",
      "accounts.google.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#081020",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#081020"
    }
  }
}
